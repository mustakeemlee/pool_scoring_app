# Run `node scripts/generate-selfhost-secrets.mjs` to generate a real
# .env.selfhost with these keys filled in with dev-grade random values.
# This file only documents what's required -- it is not itself loaded.
JWT_SECRET=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
AUTHENTICATOR_DB_PASSWORD=
SERVICE_ROLE_DB_PASSWORD=
STORAGE_DB_PASSWORD=
ANON_KEY=
SERVICE_ROLE_KEY=
# URL league members use to open the app (your PC's LAN IP), e.g. http://192.168.1.50:8080
PUBLIC_APP_URL=
